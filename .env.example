# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (scripts: create-admin, seed-demo, e2e). Never expose to the browser or Vercel "NEXT_PUBLIC_*".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Supabase → Connect → Session pooler connection string (used by `npm run db:push`)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
